rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /admins/{adminId} {
      allow read, write: if signedIn() && request.auth.uid == adminId;
    }

    match /settings/{settingId} {
      allow read, write: if signedIn();
    }

    match /{collectionName}/{documentId} {
      allow read, write: if signedIn()
        && collectionName in [
          'students',
          'schoolYears',
          'teachers',
          'subjects',
          'teacherSchedules',
          'studentSubjects',
          'payments',
          'credits',
          'attendanceLogs'
        ];
    }
  }
}
